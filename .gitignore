```yaml
name: Build APK
on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    
    steps:
    - uses: actions/checkout@v3
    
    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.9'
    
    - name: Install dependencies
      run: |
        pip install buildozer cython
        sudo apt-get update
        sudo apt-get install -y build-essential git python3 python3-dev
        sudo apt-get install -y openjdk-8-jdk
        sudo apt-get install -y libffi-dev libssl-dev libncurses5-dev libsqlite3-dev libreadline-dev libtk2-dev libgdbm-dev libdb-dev libpcap-dev xz-utils libexpat1-dev libbz2-dev liblzma-dev zlib1g-dev
        sudo apt-get install -y android-tools-adb android-tools-fastboot
    
    - name: Set up Android SDK
      run: |
        echo "y" | sudo $ANDROID_HOME/tools/bin/sdkmanager --sdk_root=$ANDROID_HOME --install "platform-tools" "platforms;android-21" "build-tools;33.0.0"
    
    - name: Build APK
      run: |
        buildozer android debug
      env:
        ANDROID_HOME: /usr/lib/android-sdk
        JAVA_HOME: /usr/lib/jvm/java-8-openjdk-amd64
    
    - name: Upload APK
      uses: actions/upload-artifact@v3
      with:
        name: apk-file
        path: bin/*.apk
```